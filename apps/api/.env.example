# Online mode (Supabase) — server-only, never exposed to the client.
# Create a project at https://supabase.com, run supabase/schema.sql in its
# SQL editor, then fill these from Project Settings → API.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Daily-challenge push notifications (mobile app only) — server-only.
# Also run supabase/push_tokens.sql once, in addition to schema.sql.
# Sending goes through Expo's push service (lib/fcm.ts, expo-server-sdk) —
# no Firebase/Apple credentials needed here; EAS manages those on the
# client build side.

# Shared secret for app/api/cron/notify-daily-challenge — set the same value
# here and as a Vercel project env var so Vercel Cron's request is the only
# one accepted (sent as `Authorization: Bearer $CRON_SECRET`).
CRON_SECRET=
